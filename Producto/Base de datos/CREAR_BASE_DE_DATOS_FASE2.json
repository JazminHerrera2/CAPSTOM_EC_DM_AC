{
  "_meta": {
    "proyecto": "tag-ok-v2",
    "fase": "Fase 2 (TAG OK 2.0)",
    "version": "1.0",
    "descripcion": "Población de las colecciones de la Fase 2. Mismo formato que EXPORTACION_BASE_DE_DATOS.json: { coleccion: { idDocumento: { datos } } }. Datos ficticios.",
    "aviso": "Verificar contra Producto/tag_ok/firestore.rules antes de cargar. Los valores marcados como 'a validar' en DOCUMENTACION_BASE_DE_DATOS_FASE2.md pueden diferir del código.",
    "secciones": {
      "base": [
        "administradores"
      ],
      "catalogo": [
        "componentes_mantencion"
      ],
      "demo": [
        "vehiculos",
        "documentos_vehiculares",
        "mantenciones",
        "notificaciones"
      ]
    },
    "marcadores": {
      "$OWNER_UID / $OWNER_EMAIL / $OWNER_NAME": "UID, correo y nombre del usuario dueño de los datos de ejemplo (SEED_OWNER_UID)",
      "$ADMIN_UID / $ADMIN_EMAIL": "UID y correo del administrador (SEED_ADMIN_UID); si no se define, el administrador se omite",
      "{\"$dias\": N, \"h\": 12, \"m\": 0}": "Fecha relativa: hoy + N días a esa hora (N puede ser negativo)",
      "{\"$ts\": \"2026-10-12T10:30:00\"}": "Fecha y hora absolutas, en hora local",
      "{\"$ref\": \"usuarios/$OWNER_UID\"}": "DocumentReference de Firestore"
    }
  },
  "_esquema": {
    "administradores": {
      "descripcion": "Existir un documento con el UID del usuario lo convierte en administrador. Solo super_admin crea, edita o borra.",
      "campos": {
        "rol": {
          "tipo": "string",
          "obligatorio": true,
          "nota": "super_admin u operador"
        },
        "email": {
          "tipo": "string",
          "obligatorio": false
        }
      }
    },
    "componentes_mantencion": {
      "descripcion": "Catálogo de componentes. Editable solo por administradores. Si está vacío la app usa valores por defecto.",
      "campos": {
        "nombre": {
          "tipo": "string",
          "obligatorio": true
        },
        "orden": {
          "tipo": "integer",
          "obligatorio": true
        },
        "activo": {
          "tipo": "boolean",
          "obligatorio": true
        }
      }
    },
    "vehiculos": {
      "descripcion": "Colección compartida con la Fase 1. Se documenta aquí porque los documentos y mantenciones se enlazan a ella.",
      "campos": {
        "id_usuario": {
          "tipo": "reference",
          "obligatorio": true,
          "referencia": "usuarios",
          "inmutable": true,
          "nota": "Reference a usuarios/{uid}"
        },
        "patente": {
          "tipo": "string",
          "obligatorio": true,
          "max": 20,
          "nota": "Única por usuario"
        },
        "categoria": {
          "tipo": "string",
          "obligatorio": false
        },
        "marca": {
          "tipo": "string",
          "obligatorio": false
        },
        "modelo": {
          "tipo": "string",
          "obligatorio": false
        },
        "tipo_vehiculo": {
          "tipo": "string",
          "obligatorio": false
        },
        "tipo_combustible": {
          "tipo": "string",
          "obligatorio": false
        },
        "alias": {
          "tipo": "string",
          "obligatorio": false
        },
        "estado": {
          "tipo": "string",
          "obligatorio": false
        },
        "fecha_ingreso": {
          "tipo": "string",
          "obligatorio": false
        },
        "foto_path": {
          "tipo": "string",
          "obligatorio": false,
          "max": 500
        },
        "anio": {
          "tipo": "integer",
          "obligatorio": false,
          "rango": [
            1900,
            2100
          ]
        },
        "kilometraje_actual": {
          "tipo": "integer",
          "obligatorio": false,
          "rango": [
            0,
            10000000
          ]
        },
        "fecha_registro": {
          "tipo": "timestamp",
          "obligatorio": false
        }
      }
    },
    "documentos_vehiculares": {
      "descripcion": "Permiso de circulación, revisión técnica, SOAP y seguro de cada vehículo.",
      "campos": {
        "uid": {
          "tipo": "string",
          "obligatorio": true,
          "referencia": "usuarios",
