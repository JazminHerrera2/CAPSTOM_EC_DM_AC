        "numero": {
          "tipo": "string",
          "obligatorio": false
        },
        "compania": {
          "tipo": "string",
          "obligatorio": false
        },
        "numero_poliza": {
          "tipo": "string",
          "obligatorio": false
        },
        "archivo_path": {
          "tipo": "string",
          "obligatorio": false,
          "nota": "Ruta en Supabase Storage"
        },
        "fecha_emision": {
          "tipo": "timestamp",
          "obligatorio": false
        },
        "fecha_vencimiento": {
          "tipo": "timestamp",
          "obligatorio": false
        },
        "fecha_captura": {
          "tipo": "timestamp",
          "obligatorio": false
        },
        "forma_pago": {
          "tipo": "string",
          "obligatorio": false,
          "valores": [
            "total",
            "cuota_1",
            "cuota_2"
          ],
          "nota": "Casilla marcada en el permiso"
        },
        "fecha_emision_estimada": {
          "tipo": "boolean",
          "obligatorio": false,
          "nota": "true si la emisión no figuraba y se completó con la fecha de ingreso"
        },
        "confianza_ia": {
          "tipo": "number",
          "obligatorio": false,
          "nota": "Escala sin rango en las reglas; ver Observaciones del documento"
        }
      }
    },
    "mantenciones": {
      "descripcion": "Mantenciones realizadas o programadas. No guarda la foto ni el PDF del comprobante.",
      "campos": {
        "uid": {
          "tipo": "string",
          "obligatorio": true,
          "referencia": "usuarios",
          "inmutable": true,
          "nota": "UID del dueño"
        },
        "vehiculo_id": {
          "tipo": "string",
          "obligatorio": true,
          "referencia": "vehiculos",
          "inmutable": true
        },
        "estado": {
          "tipo": "string",
          "obligatorio": true,
          "valores": [
            "programada",
            "realizada"
          ]
        },
        "tipo": {
          "tipo": "string",
          "obligatorio": true,
          "min": 1,
          "max": 60,
          "nota": "Título de texto libre"
        },
        "tipo_otro": {
          "tipo": "string",
          "obligatorio": false,
          "nota": "Solo mantenciones antiguas con tipo 'otra'"
        },
        "fecha": {
          "tipo": "timestamp",
          "obligatorio": false
        },
        "proxima_fecha": {
          "tipo": "timestamp",
          "obligatorio": false
        },
        "fecha_captura": {
          "tipo": "timestamp",
          "obligatorio": false
        },
        "kilometraje": {
          "tipo": "integer",
          "obligatorio": false,
          "rango": [
            0,
            5000000
          ]
        },
        "proximo_kilometraje": {
          "tipo": "integer",
          "obligatorio": false,
          "rango": [
            0,
            5000000
          ]
        },
        "costo": {
          "tipo": "integer",
          "obligatorio": false,
          "rango": [
            0,
            1000000000
          ],
          "nota": "Pesos chilenos"
        },
        "taller": {
          "tipo": "string",
          "obligatorio": false,
          "max": 100
        },
        "descripcion": {
          "tipo": "string",
          "obligatorio": false,
          "max": 500
        },
        "observaciones": {
          "tipo": "string",
          "obligatorio": false,
          "max": 1000
        },
        "tipo_comprobante": {
          "tipo": "string",
          "obligatorio": false,
          "valores": [
            "boleta",
            "factura",
            "otro"
          ]
        },
        "numero_comprobante": {
          "tipo": "string",
          "obligatorio": false,
          "max": 50
        },
        "componentes": {
          "tipo": "list",
          "obligatorio": false,
          "maxItems": 30,
          "nota": "Ids de componentes_mantencion; el formulario ya no los pide"
        },
        "origen_registro": {
          "tipo": "string",
          "obligatorio": true,
          "valores": [
            "manual",
            "ia"
          ]
        },
        "confianza_ia": {
          "tipo": "number",
          "obligatorio": false,
          "rango": [
            0,
            100
          ]
        }
      },
      "condiciones": [
        {
          "si": {
            "estado": "programada"
          },
          "alguno_de": [
            "proxima_fecha",
            "proximo_kilometraje"
          ]
        },
        {
          "si": {
            "estado": "realizada"
          },
          "requiere": [
            "fecha"
          ]
        }
      ]
    },
    "notificaciones": {
      "descripcion": "Recordatorios. El ID es {documentoId}_30dias, _15dias o _7dias para vencimientos, o el id de la mantención.",
      "campos": {
        "usuario_id": {
          "tipo": "string",
          "obligatorio": true,
          "referencia": "usuarios",
          "inmutable": true,
          "nota": "UID del dueño"
        },
        "vehiculo_id": {
          "tipo": "string",
          "obligatorio": false,
          "referencia": "vehiculos"
